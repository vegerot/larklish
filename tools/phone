#!/usr/bin/env python3
"""Small adb helpers for experiments on the test phone.

    tools/phone top                 # foreground activity (package/Activity)
    tools/phone open URL [FILE]     # go home, fire a VIEW intent (deep link), wait,
                                    #   print the foreground activity; screenshot to FILE
    tools/phone shade [FILE]        # expand the notification shade; screenshot to FILE
    tools/phone shot FILE           # screenshot to FILE
    tools/phone home                # press HOME

Used by Experiment 07 to probe Lark's AppLinks. Add a subcommand when a new
experiment needs one.
"""

import argparse
import re
import subprocess
import time


def adb(*args, capture=False):
    return subprocess.run(["adb", *args], check=True, capture_output=capture, text=capture)


def top():
    dump = adb("shell", "dumpsys", "activity", "activities", capture=True).stdout
    m = re.search(r"topResumedActivity=ActivityRecord\{\S+ u0 (\S+)", dump)
    return m.group(1) if m else "?"


def home():
    adb("shell", "input", "keyevent", "KEYCODE_HOME")


def shot(path):
    with open(path, "wb") as f:
        subprocess.run(["adb", "exec-out", "screencap", "-p"], check=True, stdout=f)
    print(f"screenshot: {path}")


def cmd_top(args):
    print(top())


def cmd_home(args):
    home()


def cmd_shot(args):
    shot(args.file)


def cmd_shade(args):
    adb("shell", "cmd", "statusbar", "expand-notifications")
    time.sleep(2)
    if args.file:
        shot(args.file)


def cmd_open(args):
    home()
    time.sleep(1)
    adb("shell", "am", "start", "-a", "android.intent.action.VIEW", "-d", f"'{args.url}'", capture=True)
    time.sleep(4)
    print(f"top: {top()}")
    if args.file:
        shot(args.file)


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("top", help="foreground activity")
    sub.add_parser("home", help="press HOME")
    sub.add_parser("shot", help="screenshot to FILE").add_argument("file")
    sub.add_parser("shade", help="expand the shade, optional screenshot").add_argument("file", nargs="?")
    o = sub.add_parser("open", help="fire a VIEW intent (deep link) and report the foreground activity")
    o.add_argument("url")
    o.add_argument("file", nargs="?")
    args = p.parse_args()
    {"top": cmd_top, "home": cmd_home, "shot": cmd_shot, "shade": cmd_shade, "open": cmd_open}[args.cmd](args)


if __name__ == "__main__":
    main()

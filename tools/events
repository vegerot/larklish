#!/usr/bin/env python3
"""Read Larklish's Relay record (`events.jsonl`) from the phone and show views of it.

    tools/events list                 # every event, newest last, local time
    tools/events list --han --since 2026-08-26T10:29  # only rows with Han text
    tools/events stats                # counts: Relays, Updates, skips and fallbacks by reason
    tools/events table --han          # Markdown table (Original | Relay | Grade) for docs
    tools/events pull events.jsonl    # save a copy; later: --file events.jsonl

The record is written by `Recorder.kt`. Timestamps in the file are UTC (`at`); views
print local time unless `--utc`. Add a subcommand when a new view is needed.
"""

import argparse
import json
import subprocess
import sys
from collections import Counter
from datetime import datetime, timezone

PACKAGE = "com.vegerot.larklish"
REASONS = {  # NotificationListenerService.REASON_*
    1: "click", 2: "cancel", 3: "cancel_all", 8: "app_cancel", 9: "app_cancel_all",
    10: "listener_cancel", 12: "group_summary_canceled", 18: "snoozed", 19: "timeout",
}


def read_events(path):
    if path:
        text = open(path, encoding="utf-8").read()
    else:
        text = subprocess.run(
            ["adb", "exec-out", "run-as", PACKAGE, "cat", "files/events.jsonl"],
            check=True, capture_output=True, text=True,
        ).stdout
    return [json.loads(line) for line in text.splitlines() if line.strip()]


def has_han(s):
    return any("一" <= c <= "鿿" or "㐀" <= c <= "䶿" for c in s)


def is_fallback(e):
    # The `~` marks the translated part: the title, or the message after `Sender: `.
    return e["relayTitle"].startswith("~") or e["relayText"].split(": ", 1)[-1].startswith("~")


def when(e, utc):
    t = datetime.fromisoformat(e["at"].replace("Z", "+00:00"))
    if not utc:
        t = t.astimezone()
    return t.strftime("%m-%d %H:%M")


def chat_id(e):
    return e["key"].split("|")[2]


def select(events, args):
    out = []
    for e in events:
        if args.since and e["at"] < args.since:
            continue
        relayed = e["event"] == "relayed"
        if e["event"] == "removed" and args.no_removed:
            continue
        if args.han and not (relayed and (has_han(e["text"]) or has_han(e["title"]))):
            continue
        if args.fallback and not (relayed and is_fallback(e)):
            continue
        out.append(e)
    return out


def cmd_list(events, args):
    for e in select(events, args):
        kind = e["event"]
        if kind == "relayed":
            mark = "~" if is_fallback(e) else " "
            print(f"{when(e, args.utc)} R{mark} [{e['title']}] {e['text']}")
            print(f"{'':11}  → [{e['relayTitle']}] {e['relayText']}")
        elif kind == "updated":
            mark = "~" if e["relayText"].startswith("~") else " "
            print(f"{when(e, args.utc)} U{mark} ({e['msgType']}) {e['fullText']}")
            print(f"{'':11}  → {e['relayText']}")
        elif kind == "skipped":
            print(f"{when(e, args.utc)} S  {e['reason']}")
        elif kind == "fallback":
            print(f"{when(e, args.utc)} F  {e['reason']}")
        else:
            r = e["reason"]
            print(f"{when(e, args.utc)} X  reason={r} ({REASONS.get(r, '?')}) chat {chat_id(e)}")


def cmd_stats(events, args):
    rows = select(events, args)
    relayed = [e for e in rows if e["event"] == "relayed"]
    removed = [e for e in rows if e["event"] == "removed"]
    han_text = [e for e in relayed if has_han(e["text"])]
    han_title = [e for e in relayed if has_han(e["title"])]
    han_any = {id(e) for e in han_text} | {id(e) for e in han_title}
    updated = [e for e in rows if e["event"] == "updated"]
    skipped = [e for e in rows if e["event"] == "skipped"]
    fell_back = [e for e in rows if e["event"] == "fallback"]
    print(f"relayed {len(relayed)}  updated {len(updated)}  skipped {len(skipped)}  removed {len(removed)}")
    print(f"fallback (~) {sum(map(is_fallback, relayed))}")
    if fell_back:  # Layer 6: why the Translator gave up — an outage, or an input Lark will not translate
        why = Counter(e["reason"].split(":")[0] for e in fell_back)
        print("fallback reasons:", ", ".join(f"{r} ×{n}" for r, n in why.most_common()))
    if updated or skipped:
        types = Counter(e["msgType"] for e in updated)
        reasons = Counter(e["reason"].split(":")[0] if e["reason"].startswith("error") else e["reason"] for e in skipped)
        print("updated types:", ", ".join(f"{t} ×{n}" for t, n in types.most_common()) or "-")
        print("skipped reasons:", ", ".join(f"{r} ×{n}" for r, n in reasons.most_common()) or "-")
    print(f"han in text {len(han_text)}  han in title {len(han_title)}  english pass-through {len(relayed) - len(han_any)}")
    print("removal reasons:", ", ".join(f"{r} ({REASONS.get(r, '?')}) ×{n}" for r, n in sorted(Counter(e['reason'] for e in removed).items())))
    if relayed:
        print(f"span {when(relayed[0], args.utc)} → {when(relayed[-1], args.utc)}")


def cmd_table(events, args):
    cell = lambda s: s.replace("|", "\\|")
    print("| Original | Relay | Grade |")
    print("| --- | --- | --- |")
    for e in select(events, args):
        if e["event"] != "relayed":
            continue
        original = f"{cell(e['text'])}" if not has_han(e["title"]) else f"title {cell(e['title'])} · {cell(e['text'])}"
        relay = f"{cell(e['relayText'])}" if not has_han(e["title"]) else f"title {cell(e['relayTitle'])} · {cell(e['relayText'])}"
        print(f"| {original} | {relay} |  |")


def cmd_pull(events, args):
    with open(args.out, "w", encoding="utf-8") as f:
        for e in events:
            f.write(json.dumps(e, ensure_ascii=False) + "\n")
    print(f"{len(events)} events → {args.out}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--file", help="read this saved copy instead of the phone")
    p.add_argument("--since", help="ISO UTC prefix, e.g. 2026-08-26T17:29 (Layer 4 went live)")
    p.add_argument("--han", action="store_true", help="only Relays whose Original has Han text")
    p.add_argument("--fallback", action="store_true", help="only Relays produced by the ML Kit fallback (~)")
    p.add_argument("--no-removed", action="store_true", help="hide removal events")
    p.add_argument("--utc", action="store_true", help="print UTC instead of local time")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="every event, oldest first")
    sub.add_parser("stats", help="counts")
    sub.add_parser("table", help="Markdown table of Relays for the experiment docs")
    pull = sub.add_parser("pull", help="save the raw JSONL")
    pull.add_argument("out")
    args = p.parse_args()
    events = read_events(args.file)
    {"list": cmd_list, "stats": cmd_stats, "table": cmd_table, "pull": cmd_pull}[args.cmd](events, args)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Show or reset Larklish's chat-id cache (`filesDir/chats.json`).

    tools/chats            # every title the app has resolved, and to which chat
    tools/chats --clear    # delete the file *and* force-stop, so the service drops its copy

The service keeps the map in memory, so deleting the file alone changes nothing —
that is why --clear force-stops. Layer 6 only caches a chat a message confirmed, so a
reset is rarely needed; use it after a chat is renamed or a bad entry is suspected.
"""

import argparse
import json
import subprocess
import sys

PACKAGE = "com.vegerot.larklish"


def adb(*args, **kw):
    """Run adb and fail loudly. A missing phone must never read as a missing cache."""
    out = subprocess.run(["adb", *args], capture_output=True, text=True, **kw)
    if out.returncode != 0 and "No such file" not in out.stderr:
        sys.exit(f"adb {' '.join(args)}: {(out.stderr or out.stdout).strip()}")
    return out


def require_device():
    """`adb logcat` waits forever when no phone is attached, so check before anything blocks."""
    out = subprocess.run(["adb", "devices"], capture_output=True, text=True)
    if not [l for l in out.stdout.splitlines()[1:] if l.strip().endswith("\tdevice")]:
        sys.exit("no phone on adb — check the cable, then `adb devices`")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--clear", action="store_true", help="delete the cache and force-stop the app")
    args = p.parse_args()
    require_device()

    if args.clear:
        adb("shell", "run-as", PACKAGE, "rm", "-f", "files/chats.json")
        adb("shell", "am", "force-stop", PACKAGE)
        print("cache deleted and app force-stopped; it rebuilds on the next Original")
        return 0

    # `adb exec-out` folds the device's stderr into stdout, so a missing file arrives as text.
    raw = adb("exec-out", "run-as", PACKAGE, "cat", "files/chats.json").stdout.strip()
    if not raw.startswith("{"):
        print("no cache yet — nothing has been resolved")
        return 0
    chats = json.loads(raw)
    groups = {k: v for k, v in chats.items() if not k.startswith("dm:")}
    dms = {k[3:]: v for k, v in chats.items() if k.startswith("dm:")}
    for label, rows in (("groups", groups), ("DMs", dms)):
        print(f"\n{label} ({len(rows)})")
        for name, chat in sorted(rows.items()):
            print(f"  {chat}  {name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
